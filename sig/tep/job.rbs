# Sidekiq-shaped background job queue, backed by SQLite. Subclass
# `Tep::Job` and override `#perform(arg)`; enqueue via the class-side
# `enqueue(name, arg, db_path)`.
module Tep
  class Job
    # Subclass override. The base returns "" so the dispatch table
    # stays type-safe.
    def perform: (String arg) -> String

    attr_accessor jid: Integer
    attr_accessor db_path: String
    def initialize: () -> void

    # Report progress from inside perform (column + Broadcast "job:<id>").
    def progress: (String payload) -> Integer
    def self.progress: (String db_path, Integer row_id, String payload) -> Integer

    # name -> subclass dispatch; generated by bin/tep, raises otherwise.
    def self.dispatch: (String name, String arg, Integer row_id, String db_path) -> String

    # Claim + run one job (1 if one ran), run until empty, loop until shutdown.
    def self.work_one: (String db_path) -> Integer
    def self.drain: (String db_path) -> Integer
    def self.work: (String db_path, Integer poll_seconds) -> Integer

    # CREATE TABLE if not exists. Returns 0 on success.
    def self.init_schema: (String db_path) -> Integer

    # Insert a queued row. Returns the new rowid.
    def self.enqueue: (String name, String arg, String db_path) -> Integer

    # Sidekiq perform_in: claimable `seconds` from now.
    def self.enqueue_in: (Integer seconds, String name, String arg, String db_path) -> Integer

    # General form: first-attempt delay + retries after the first attempt.
    def self.enqueue_opts: (String name, String arg, String db_path, Integer delay_seconds, Integer max_retries) -> Integer

    def self.added_columns: () -> Array[String]

    # Atomically claim the next due row. Returns "row_id|name|arg"
    # (split on "|" with limit 3), or "" if nothing is claimable.
    def self.fetch_next: (String db_path) -> String

    # Mark a row done + persist the result string into the row's
    # `result` column. Returns 1 on success, 0 on db failure.
    def self.mark_done: (String db_path, Integer row_id, String result) -> Integer

    # Requeue with backoff while retries remain, else mark failed;
    # stores the message. Returns 1 if requeued, 0 if terminal.
    def self.retry_or_fail: (String db_path, Integer row_id, String error) -> Integer

    # Requeue (or fail) rows left `running` by a dead worker.
    def self.requeue_stale: (String db_path, Integer older_than_seconds) -> Integer

    # Mark a row failed unconditionally; does not touch `error`.
    def self.mark_failed: (String db_path, Integer row_id) -> Integer
  end
end
